# Vendored upstream repos (OnT, CrystaLLM) — cloned locally so we can run/read them, but they're
# someone else's history and CrystaLLM alone carries ~150MB of benchmark CIFs we don't need to
# carry in our own git history. Re-clone from the URLs in docs/ if this checkout is missing them.
/OnT/
/CrystaLLM/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# OS
.DS_Store

# Claude Code local session state (matches the parent battGPT repo's own .gitignore convention)
/.claude

# Generated data / model artifacts (large, reproducible from scripts — not source)
/data/battgpt_abox/
*.jsonl
!examples/*.jsonl
# data/battgpt_ont/ is the TBox's *.jsonl output (train.jsonl etc.) -- unlike the bulk ABox
# output above, this is tiny (a few KB, ~19 rows today) and kept as concrete, committed evidence
# of what tbox/prepare.py actually produces, not just a description of it (see BUILD_LOG.md
# Step 12). Re-review this exception if the TBox grows large enough that this stops being true.
!/data/battgpt_ont/*.jsonl
# data/battgpt_merged_*/ (merge_datasets.py output) mostly duplicates content already tracked
# elsewhere: its *.jsonl is large and regenerable (already excluded above), and its copied
# concept_names.json/role_names.json/role_inverse.json/val.json are byte-identical to the ones
# already committed under data/battgpt_ont/ -- no reason to track the same bytes twice. Only
# merge_summary.json (the actual counts this step produced -- oversample factors, dropped-row
# counts) is genuinely new, so only that is kept.
/data/battgpt_merged_*/*
!/data/battgpt_merged_*/merge_summary.json
export_package/
*.pt
*.ckpt
