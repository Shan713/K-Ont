# Vendored upstream repos (OnT, CrystaLLM) — cloned locally so we can run/read them, but they're
# someone else's history and CrystaLLM alone carries ~150MB of benchmark CIFs we don't need to
# carry in our own git history. Re-clone from the URLs in docs/ if this checkout is missing them.
/OnT/
/CrystaLLM/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# OS
.DS_Store

# Claude Code local session state (matches the parent battGPT repo's own .gitignore convention)
/.claude

# Generated data / model artifacts (large, reproducible from scripts — not source)
/data/battgpt_abox/
/data/battgpt_abox_split/
/data/battgpt_abox_split_*/
# data/backup_*/: local snapshots of generated data taken before a regeneration (e.g. Step 16), kept
# only so old vs new can be diffed on this machine -- same size/reproducibility reasoning as above.
/data/backup_*/
*.jsonl
!examples/*.jsonl
# data/battgpt_ont/ is the TBox's *.jsonl output (train.jsonl etc.) -- unlike the bulk ABox
# output above, this is tiny (a few KB, ~19 rows today) and kept as concrete, committed evidence
# of what tbox/prepare.py actually produces, not just a description of it (see BUILD_LOG.md
# Step 12). Re-review this exception if the TBox grows large enough that this stops being true.
!/data/battgpt_ont/*.jsonl
# data/battgpt_merged_*/ (merge_datasets.py output) mostly duplicates content already tracked
# elsewhere: its *.jsonl is large and regenerable (already excluded above), and its copied
# concept_names.json/role_names.json/role_inverse.json/val.json are byte-identical to the ones
# already committed under data/battgpt_ont/ -- no reason to track the same bytes twice. Only
# merge_summary.json (the actual counts this step produced -- oversample factors, dropped-row
# counts) is genuinely new, so only that is kept.
/data/battgpt_merged_*/*
!/data/battgpt_merged_*/merge_summary.json
# data/runs/<run>/ (train_ont.py output): model weights, checkpoints, a copy of the merged data and
# a tqdm-heavy log -- large and reproducible from train_ont.py. Only step_times.json (the measured
# per-step times, peak GPU memory and run config) and phase5_checks.json (abox/phase5_checks.py
# output) are kept -- the evidence BUILD_LOG.md Step 15 cites.
/data/runs/*/*
!/data/runs/*/step_times.json
!/data/runs/*/phase5_checks.json
export_package/
*.pt
*.ckpt

# data/fyp_compare/: teammate (FYP_K-OnT) pipeline run on our KG (Step 20). Model weights and
# regenerable rows ignored; the report and the leak-probe script + output are kept as evidence.
/data/fyp_compare/*
!/data/fyp_compare/leak_probe.py
!/data/fyp_compare/leak_probe.txt
!/data/fyp_compare/abox/
/data/fyp_compare/abox/*
!/data/fyp_compare/abox/phase5b_report.json

# CrystaLLM environment + Phase C (BUILD_LOG Step 25). The venv (~2.5 GB) and the CrystaLLM model
# archives/checkpoints (285 MB small, 2.2 GB large; Zenodo record 10642388) are downloaded, not
# committed -- docs/WORKSTATION_SETUP.md says how. Kept: CrystaLLM's held-out test set (1.6 MB),
# the test compositions with our space-group predictions, and the small-model results + log.
/.venv-crystallm/
/data/crystallm/*
!/data/crystallm/cifs_v1_test.tar.gz
!/data/crystallm/phaseC_test_with_pred.json
!/data/crystallm/phaseC_results.json
!/data/crystallm/phaseC_run.log
!/data/crystallm/phaseC_results_large.json
!/data/crystallm/phaseC_large_run.log
!/data/crystallm/phaseC_results_small_seeded.json
!/data/crystallm/phaseC_small_seeded_run.log
# Phase C overnight queue (abox/phaseC_overnight.py): all result/score JSONs, the sanity set, the
# driver logs + summary, and one tarball of the generated CIFs (small text, a few MB)
!/data/crystallm/phaseC_results_*.json
!/data/crystallm/phaseC_nearmiss_*.json
!/data/crystallm/phaseC_chgnet_*.json
!/data/crystallm/phaseC_sanity_candidates.json
!/data/crystallm/phaseC_generated_cifs.tar.gz
!/data/crystallm/overnight/
# Novel-cathode pilot (abox/novel_*.py): candidates, results, CHGNet scores, logs, CIF tarball
!/data/crystallm/novel_candidates.json
!/data/crystallm/novel_results_*.json
!/data/crystallm/novel_chgnet_*.json
!/data/crystallm/novel_logs/
!/data/crystallm/novel_generated_cifs.tar.gz
# KG-steered generation (abox/kg_priors.py, abox/kg_steer.py): priors from the KG and the evaluation
!/data/crystallm/kg_priors.json
!/data/crystallm/kg_steer_eval.json
!/data/crystallm/kg_steer_eval.log
!/data/crystallm/kg_scores_*.json
!/data/crystallm/kg_steer_sample_*.json
!/data/crystallm/kg_steer_generated_cifs.tar.gz
!/data/crystallm/novel_parents.json
!/data/crystallm/novel_steer_analysis.json
!/data/crystallm/novel_shortlist.md
!/data/crystallm/steer_logs/
!/data/crystallm/stability_*.json
!/data/crystallm/stability_*.log
# KG-driven generation handoff (docs/HANDOFF_KG_STEERING.md): training source, analogues, A/B outputs
!/data/crystallm/kg_training_source.json.gz
!/data/crystallm/test_analogues.json
!/data/crystallm/seeded_*.json
!/data/crystallm/seeded_*.tar.gz
!/data/crystallm/dpo_*.jsonl
!/data/crystallm/dpo_*.json
!/data/crystallm/novel_best.tar.gz
# Grown-KG extractions (26-111 MB, regenerable with abox/extract.py from battGPT's grown KGs) and
# the top-level training logs/status files in data/runs/.
/data/battgpt_abox_grow_*/
/data/runs/*.log
/data/runs/*_status.txt
