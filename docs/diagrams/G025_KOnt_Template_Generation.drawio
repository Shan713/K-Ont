<mxfile host="app.diagrams.net"><diagram name="K-Ont template generation" id="kont-templates"><mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;K-Ont template generation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Knowledge-guided crystal structure prediction for a new cathode composition&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="50" as="geometry"/></mxCell><mxCell id="c4" value="1  Offline: build the knowledge and train K-Ont (once)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#2E8B8B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#2E8B8B;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1560" height="230" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;battGPT ontology (TBox)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;classes, axioms, structure families&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF6F5;strokeColor=#2E8B8B;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="180" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Knowledge graph (ABox)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;5,000 Li/Na materials from Materials Project&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF6F5;strokeColor=#2E8B8B;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="195" width="180" height="66" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Verbalizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;each material -&amp;gt; text description&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F5F7;strokeColor=#888888;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="195" width="170" height="66" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;K-Ont training&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;OnT objective in a Poincare ball: axiom, typing and relation rows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8E1E8;strokeColor=#A4123F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="220" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Framework retrieval fine-tune&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;relation &amp;#x27;has the framework of&amp;#x27; + retention of KG, GALEN and relation phrases (one model)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8E1E8;strokeColor=#A4123F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="130" width="240" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;K-Ont retriever&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;hyperbolic text encoder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8E1E8;strokeColor=#A4123F;fontFamily=Helvetica;fontSize=12;fontColor=#A4123F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="170" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Template pool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;KG materials with known crystal structures (5,000 + 5,267 extension)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF6F5;strokeColor=#2E8B8B;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="130" width="260" height="90" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="known structures" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="275"/><mxPoint x="1420" y="275"/></Array></mxGeometry></mxCell><mxCell id="c18" value="2  Per new composition: generate, then pick one structure" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#A4123F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#A4123F;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="1560" height="310" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Input composition&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;e.g. NaMnPO4 (formula + cell), no structure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="170" height="76" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Structure-free description&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;formula, elements, chemistry; no space group or lattice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F5F7;strokeColor=#888888;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="495" width="190" height="66" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Same-pattern candidates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;anonymous formula ABCD4 -&amp;gt; LiFePO4, LiMnPO4, ...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F5F7;strokeColor=#888888;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="380" width="190" height="66" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Rank frameworks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;K-Ont similarity + gradient-boosted ranker over KG facts -&amp;gt; top 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8E1E8;strokeColor=#A4123F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="420" width="220" height="90" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Element substitution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;match elements by amount, then electronegativity; scale cell by atomic radii -&amp;gt; 3 templates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF6F5;strokeColor=#2E8B8B;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="420" width="220" height="90" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;CrystaLLM (fine-tuned)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;crystal language model -&amp;gt; 5 samples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EFE6F7;strokeColor=#7E5CA6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="535" width="220" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;CHGNet relaxation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;relax all 8 candidates; lowest energy per atom wins&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2EA;strokeColor=#2F7A55;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="460" width="210" height="90" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Predicted structure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;one crystal structure (CIF)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="470" width="190" height="70" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="3 templates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="590"/></Array></mxGeometry></mxCell><mxCell id="c34" value="5 samples" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="encodes the description and each candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A4123F;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1145" y="300"/><mxPoint x="640" y="300"/></Array></mxGeometry></mxCell><mxCell id="c37" value="candidate frameworks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2E8B8B;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c11" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="352"/><mxPoint x="375" y="352"/></Array></mxGeometry></mxCell><mxCell id="c38" value="3  Results (902 held-out materials; 199 novel cathode compositions)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#555555;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="1560" height="120" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Right at the first attempt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;K-Ont templates 60.5%  vs  CrystaLLM 48.3%, Hautier 52.1%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="360" height="60" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Right within 8 attempts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;3 templates + 5 CrystaLLM 77.3%  vs  8 CrystaLLM 68.3%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="690" width="360" height="60" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;One committed answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;CHGNet pick 69.3%  vs  CrystaLLM alone 63.7%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="690" width="360" height="60" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Novel cathodes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;lower energy 34 / higher 0; independent E_hull confirms 32 of 34&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1205" y="690" width="360" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>