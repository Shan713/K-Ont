+    def _in_batch_negative_index(self):
+        """K-Ont (BUILD_LOG.md Step 17): for each exist row i in the current batch, the index j of
+        another row to use as its negative, or -1.
+
+        Why: upstream borrows exist negatives from the concurrent train.jsonl batch's negative column.
+        On our data 96% of those are short class labels ("space group", "chemical element"), so a
+        hasStructure row almost never has to tell crystal A from crystal B (measured, Step 16). This
+        adds the standard in-batch contrast: material_i vs ∃hasStructure.crystal_j of another row.
+
+        A row j qualifies as i's negative only if:
+          * same role (∃r.D_j and ∃r.D_i share the rotation, so only the filler differs);
+          * both fillers are INSTANCE sentences, not TBox class names -- "material ⊑ ∃hasStructure.
+            crystal structure" is TRUE, so a class-name filler must never be used as a negative, and
+            TBox rows are left to the upstream loss untouched;
+          * the filler TEXT differs -- identical text (e.g. no_geometry crystals sharing a symmetry,
+            two materials both "Battery role: cathode") would be the impossible "push away from what
+            you're pulled toward" target Step 13 removed from the type rows.
+        """
+        roles, cons = self._last_exist_rows
+        n = len(cons)
+        idx = []
+        for i in range(n):
+            if cons[i] in self._concept_set:
+                idx.append(-1)
+                continue
+            cand = [j for j in range(n) if j != i and roles[j] == roles[i]
+                    and cons[j] not in self._concept_set and cons[j] != cons[i]]
+            idx.append(random.choice(cand) if cand else -1)
+        st = self.in_batch_stats
+        st["calls"] += 1
+        st["rows_seen"] += n
+        st["rows_with_negative"] += sum(j >= 0 for j in idx)
+        return idx
+
