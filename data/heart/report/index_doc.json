{"text": "<style>\n/* Layout: one reading column (max 70rem) of short chapters, each a heading, a plain-language note and its chart. */\n#dash-root { --dash-gutter: clamp(16px, 4vw, 40px); }\n.hr { max-width: 70rem; margin-inline: auto; display: grid; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n.hr h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.hr h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; text-wrap: balance; }\n.hr h3 { font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.hr p { margin: 0; max-width: 68ch; line-height: 1.55; }\n.hr .muted { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.hr .lede { font-size: var(--cds-font-size-body); color: var(--color-fg-muted); max-width: 72ch; }\n.hr section { display: grid; gap: var(--cds-gap-md); }\n.hr .grid { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }\n.hr .card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); align-content: start; min-width: 0; }\n.hr .tiles { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }\n.hr .tile .big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; }\n.hr .chart { position: relative; min-height: 220px; }\n.hr .chart svg { display: block; overflow: visible; }\n.hr .tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; z-index: 2; }\n.hr .tip .t { color: var(--cds-text-secondary); }\n.hr .legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.hr .legend span { display: inline-flex; align-items: center; gap: .4em; }\n.hr .sw { width: .7rem; height: .7rem; border-radius: 50%; display: inline-block; }\n.hr .sw.ring { background: transparent !important; border: 2px solid currentColor; }\n.hr table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.hr th, .hr td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n.hr th { color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); }\n.hr td.num, .hr th.num { text-align: right; }\n.hr .scroll { overflow-x: auto; }\n.hr .pill { display: inline-block; padding: .05rem .5rem; border-radius: 999px; border: 1px solid var(--color-border-line); font-size: var(--cds-font-size-caption); margin: .1rem .2rem .1rem 0; }\n.hr .patient { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: var(--cds-font-size-caption); line-height: 1.6; white-space: pre-wrap; margin: 0; }\n.hr .seg { display: inline-flex; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); overflow: hidden; flex-wrap: wrap; }\n.hr .seg button { font: inherit; font-size: var(--cds-font-size-caption); padding: .3rem .7rem; background: transparent; color: var(--color-fg); border: 0; border-right: 1px solid var(--color-border-line); cursor: pointer; }\n.hr .seg button:last-child { border-right: 0; }\n.hr .seg button[aria-pressed=\"true\"] { background: var(--color-fg); color: var(--color-bg); }\n.hr .seg button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 2px; }\n.hr .good { color: var(--color-ok); }\n.hr .bad { color: var(--color-bad); }\n.hr ul { margin: 0; padding-left: 1.2rem; display: grid; gap: .35rem; max-width: 72ch; line-height: 1.5; }\n.hr .cols { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"hr\">\n  <header style=\"display:grid; gap: var(--cds-gap-sm)\">\n    <h1 id=\"top\">K-Ont vs OnT on heart disease</h1>\n    <p class=\"lede\">Does embedding a knowledge graph with K-Ont help a heart-disease classifier more than standard OnT? 303 patients (UCI Cleveland), the heart ontology and its knowledge graph, 5 classifiers, 10 cross-validation folds. The diagnosis is never shown to OnT or K-Ont.</p>\n  </header>\n\n  <section id=\"headline\" class=\"tiles\">\n    <div class=\"card tile\">\n      <span class=\"muted\">K-Ont vs OnT as a patient representation (AUC, mean over 5 models)</span>\n      <span class=\"big\" data-source=\"hl_kont_vs_ont\" data-field=\"value\">\u2014</span>\n      <span class=\"muted\"><span data-source=\"hl_kont_vs_ont\" data-field=\"sig\">\u2014</span> of 5 models significantly better (p &lt; 0.05)</span>\n    </div>\n    <div class=\"card tile\">\n      <span class=\"muted\">Adding K-Ont to the full table (AUC change, mean over 5 models)</span>\n      <span class=\"big\" data-source=\"hl_full\" data-field=\"value\">\u2014</span>\n      <span class=\"muted\">Raw + K-Ont vs raw table, all labels</span>\n    </div>\n    <div class=\"card tile\">\n      <span class=\"muted\">With 10% of the labels (AUC change, mean over 5 models)</span>\n      <span class=\"big\" data-source=\"hl_few\" data-field=\"value\">\u2014</span>\n      <span class=\"muted\">Raw + K-Ont vs raw table</span>\n    </div>\n    <div class=\"card tile\">\n      <span class=\"muted\">Three columns missing from the table (AUC change, mean over 5 models)</span>\n      <span class=\"big\" data-source=\"hl_missing\" data-field=\"value\">\u2014</span>\n      <span class=\"muted\">Raw + K-Ont vs the reduced table; chest pain, thallium and vessels hidden</span>\n    </div>\n  </section>\n\n  <section id=\"setup\">\n    <h2>What was compared</h2>\n    <div class=\"cols\">\n      <div class=\"card\">\n        <h3>Standard OnT</h3>\n        <p>Trained on the heart ontology's 32 classes only, with OnT's own data preparation. It has no place for individual patients, so a patient is represented by the OnT vectors of its five categorical values (gender, chest pain type, resting ECG, ST slope, thallium scan).</p>\n      </div>\n      <div class=\"card\">\n        <h3>K-Ont</h3>\n        <p>OnT extended to the knowledge graph: the ontology plus the training patients as individuals. Each patient is one short sentence of all 13 facts, typed under \"patient\" and linked by the five relations to its value concepts. Retrained inside every fold on that fold's training patients; test patients are only encoded.</p>\n      </div>\n      <div class=\"card\">\n        <h3>Controls and models</h3>\n        <p>The raw 13-column table alone; the plain, untrained encoder reading the same patient sentence; logistic regression, random forest, SVM, gradient boosting and a small neural network (MLP). Embeddings are reduced to 16 numbers per patient (PCA) before the classifiers see them. The diagnosis link is removed from everything the encoders see.</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"example\">\n    <h2>One patient, two ways</h2>\n    <p class=\"muted\">Pick a patient. OnT sees five separate concepts; K-Ont turns the whole record into one vector and finds the patient's nearest neighbours by it.</p>\n    <div class=\"seg\" id=\"ex-pick\" role=\"group\" aria-label=\"Example patient\"></div>\n    <div class=\"cols\">\n      <div class=\"card\" data-source=\"example_patients example_labels\">\n        <h3 id=\"ex-title\">Patient</h3>\n        <span class=\"muted\" id=\"ex-meta\"></span>\n        <pre class=\"patient\" id=\"ex-text\"></pre>\n      </div>\n      <div class=\"card\" data-source=\"example_vectors\">\n        <h3>What each model hands the classifier</h3>\n        <p class=\"muted\">First 24 of 384 numbers, coloured by sign and size. OnT: the vector of the first concept only (it has five, one per category). K-Ont: one vector for the whole patient.</p>\n        <div class=\"chart\" id=\"ex-vec\" style=\"min-height:120px\"></div>\n        <div id=\"ex-concepts\"></div>\n      </div>\n    </div>\n    <div class=\"card\" data-source=\"example_neighbours\">\n      <h3>Nearest patients</h3>\n      <p class=\"muted\">The five closest patients by each representation, with their categorical values. Diagnoses are shown here for reading only; the encoders never saw them.</p>\n      <div class=\"cols\" id=\"ex-nb\"></div>\n    </div>\n  </section>\n\n  <section id=\"place\">\n    <h2>Where each model puts patients</h2>\n    <div class=\"grid\">\n      <div class=\"card\" data-source=\"patient_typing\">\n        <h3>Which ontology class is nearest each patient?</h3>\n        <p class=\"muted\">All 303 patients; for K-Ont, the 61 of fold 0's test set were never trained on. The right answer is \"patient\".</p>\n        <div class=\"chart\" id=\"typing\" style=\"min-height:150px\"></div>\n      </div>\n      <div class=\"card\" data-source=\"depth\">\n        <h3>Distance from the centre of the ball</h3>\n        <p class=\"muted\">In a hyperbolic embedding, general classes sit near the centre and specific ones further out. Each dot is a class, by its level in the ontology; the last row is the patients.</p>\n        <div class=\"chart\" id=\"depth\" style=\"min-height:240px\"></div>\n        <div class=\"legend\" id=\"depth-legend\"></div>\n      </div>\n    </div>\n    <div class=\"card\" data-source=\"patient_map\">\n      <h3>Map of all 303 patients</h3>\n      <p class=\"muted\">Each representation squeezed to two dimensions (t-SNE). Colour is the diagnosis, for reading only. Hollow circles: fold 0's test patients, which K-Ont never trained on. OnT gives many patients the exact same point.</p>\n      <div class=\"legend\" id=\"map-legend\"></div>\n      <div class=\"grid\" id=\"maps\"></div>\n    </div>\n    <div class=\"card\" data-source=\"checks\">\n      <h3>Checks on the representations</h3>\n      <p class=\"muted\">Relation rows: rotate each value concept by the relation and see if the patient's own value is nearest (fold 0 test patients). k-NN row: how often a patient's 10 nearest neighbours share its diagnosis.</p>\n      <div class=\"scroll\"><table id=\"checks-table\" data-source=\"checks\" data-row-key=\"check,representation\">\n        <thead><tr><th data-field=\"check\">Check</th><th data-field=\"representation\">Representation</th><th class=\"num\" data-field=\"value\">Result</th><th class=\"num\" data-field=\"chance\">Chance</th></tr></thead>\n        <tbody></tbody></table></div>\n    </div>\n  </section>\n\n  <section id=\"full\">\n    <h2>Test 1: prediction with the full table and all labels</h2>\n    <p class=\"muted\">ROC-AUC, mean of 10 folds. Left: the raw table with and without each embedding. Right: each embedding on its own.</p>\n    <div class=\"legend\" id=\"full-legend\"></div>\n    <div class=\"grid\">\n      <div class=\"card\" data-source=\"main_results\"><h3>Raw table + embedding</h3><div class=\"chart\" id=\"full-raw\"></div></div>\n      <div class=\"card\" data-source=\"main_results\"><h3>Embedding on its own</h3><div class=\"chart\" id=\"full-emb\"></div></div>\n    </div>\n    <div class=\"card\">\n      <h3>Paired differences in AUC, fold by fold</h3>\n      <p class=\"muted\">Positive = the first set is better. Wins / losses over 10 folds; p from a Wilcoxon signed-rank test.</p>\n      <div class=\"scroll\"><table id=\"paired-table\" data-source=\"main_paired\" data-row-key=\"model,comparison,metric\">\n        <thead><tr><th data-field=\"model\">Model</th><th data-field=\"comparison\">Comparison</th><th class=\"num\" data-field=\"diff_pts\">AUC change (pts)</th><th class=\"num\" data-field=\"wins\">Wins</th><th class=\"num\" data-field=\"losses\">Losses</th><th class=\"num\" data-field=\"p\">p</th></tr></thead>\n        <tbody></tbody></table></div>\n    </div>\n  </section>\n\n  <section id=\"few\">\n    <h2>Test 2: few labelled patients</h2>\n    <p class=\"muted\">The classifiers learn from 10, 20, 50 or 100% of the training patients' labels (3 random subsets per fold). The embeddings come from all training patients without labels, which is fair because no encoder ever sees a diagnosis.</p>\n    <p class=\"muted\">Gradient boosting cannot split on 24 patients (its minimum leaf size is 20), so at 10% it predicts one value for everyone with every feature set.</p>\n    <div class=\"seg\" id=\"few-pick\" role=\"group\" aria-label=\"Model\"></div>\n    <div class=\"grid\">\n      <div class=\"card\" data-source=\"fewlabels\"><h3>AUC by share of labels</h3><div class=\"legend\" id=\"few-legend\"></div><div class=\"chart\" id=\"few-chart\" style=\"min-height:260px\"></div></div>\n      <div class=\"card\"><h3>Raw + K-Ont vs the others, by share of labels</h3>\n        <div class=\"scroll\"><table id=\"few-table\" data-source=\"fewlabels_paired\" data-row-key=\"labels_pct,model,comparison\">\n          <thead><tr><th data-field=\"labels_pct\" class=\"num\">Labels %</th><th data-field=\"model\">Model</th><th data-field=\"comparison\">Comparison</th><th class=\"num\" data-field=\"auc_diff_pts\">AUC change (pts)</th><th class=\"num\" data-field=\"wins\">Wins</th><th class=\"num\" data-field=\"losses\">Losses</th><th class=\"num\" data-field=\"p\">p</th></tr></thead>\n          <tbody></tbody></table></div></div>\n    </div>\n  </section>\n\n  <section id=\"missing\">\n    <h2>Test 3: columns missing from the table</h2>\n    <p class=\"muted\">Chest pain type and thallium scan (and, in the second case, the number of major vessels) are removed from the table, while the knowledge graph embedding still holds them. Can it carry the information back? OnT's concept vectors include chest pain and thallium but not vessels; K-Ont's patient sentence includes all three.</p>\n    <div class=\"grid\" id=\"missing-charts\"></div>\n    <div class=\"card\"><h3>Raw + K-Ont vs the others, with columns hidden</h3>\n      <div class=\"scroll\"><table id=\"missing-table\" data-source=\"missing_paired\" data-row-key=\"scenario,model,comparison\">\n        <thead><tr><th data-field=\"scenario\">Hidden</th><th data-field=\"model\">Model</th><th data-field=\"comparison\">Comparison</th><th class=\"num\" data-field=\"auc_diff_pts\">AUC change (pts)</th><th class=\"num\" data-field=\"wins\">Wins</th><th class=\"num\" data-field=\"losses\">Losses</th><th class=\"num\" data-field=\"p\">p</th></tr></thead>\n        <tbody></tbody></table></div></div>\n  </section>\n\n  <section id=\"reading\">\n    <h2>How to read this</h2>\n    <div class=\"card\">\n      <ul id=\"reading-list\">\n        <li>K-Ont is a better representation of patients than standard OnT: it places every patient, including unseen ones, under the ontology's \"patient\" class, keeps every patient distinct, and its vectors predict the diagnosis better than OnT's on their own.</li>\n        <li>When the classifier already has the complete table and enough labels, no embedding adds anything: the table holds all the information the knowledge graph has, and this ontology states no medical knowledge (risk factors, causes) beyond the columns.</li>\n        <li>K-Ont's own training is not what makes the difference here: the plain encoder reading the same sentence scores about the same. The gain over OnT comes from embedding the whole patient rather than separate concepts.</li>\n        <li>With few labels the embeddings hurt rather than help: 16 extra numbers per patient on 24 to 48 labelled patients let the classifiers overfit. Pretrained vectors help with few labels only when they carry information the few labels cannot provide, and here they repeat the table.</li>\n        <li>When columns are missing from the table, the knowledge-graph embedding brings their information back: with chest pain, thallium and vessels hidden, adding K-Ont lifts every model significantly. It edges OnT because OnT can only hold categorical concepts, not the number of vessels. The plain encoder reading the same sentence does as well, so the benefit comes from embedding each patient's facts, which needs individual embedding as K-Ont does, not from K-Ont's extra training.</li>\n        <li>So a knowledge-graph embedding pays off where the graph holds something the classifier's own input does not. For a stronger case: a graph with real domain knowledge (risk factors, drugs, conditions, links between patients), and a K-Ont training signal tied to it.</li>\n      </ul>\n    </div>\n    <p class=\"muted\">Code: K-Ont repository, heart/kont_heart.py and heart/report_data.py. Folds: stratified 5-fold, repeated twice, identical for every model and feature set.</p>\n  </section>\n</div>\n\n<script>\n(() => {\n  const FEATS = [\"Raw table\", \"Raw + OnT\", \"Raw + K-Ont\", \"Raw + plain encoder\"];\n  const EMBS = [\"OnT only\", \"K-Ont only\", \"Plain encoder only\"];\n  const MODELS = [\"LogReg\", \"RandomForest\", \"SVM\", \"GradBoost\", \"MLP\"];\n  const color = (f) => ({ \"Raw table\": \"var(--cds-chart-muted)\", \"Raw + OnT\": dash.colors[1], \"OnT only\": dash.colors[1],\n    \"OnT (5 concepts)\": dash.colors[1], \"OnT\": dash.colors[1], \"Raw + K-Ont\": dash.colors[0], \"K-Ont only\": dash.colors[0],\n    \"K-Ont\": dash.colors[0], \"Raw + plain encoder\": dash.colors[2], \"Plain encoder only\": dash.colors[2],\n    \"Untrained encoder\": dash.colors[2] })[f] || \"var(--cds-chart-muted)\";\n  const DIAG = { \"No heart disease\": dash.colors[4], \"Heart disease\": dash.colors[5] };\n  const signed = (v) => (v > 0 ? \"+\" : v < 0 ? \"\u2212\" : \"\u00b1\") + Math.abs(v).toFixed(1);\n  window.hrState = window.hrState || { patient: \"patient_001\", model: \"All models\" };\n\n  const mean = (a) => a.reduce((s, x) => s + x, 0) / a.length;\n  dash.calc(\"hl_kont_vs_ont\", { inputs: [\"main_paired\"], title: \"K-Ont vs OnT alone\",\n    description: \"Mean AUC change of K-Ont only over OnT only across the 5 models, and how many are significant.\",\n    fn: (main_paired) => { const r = main_paired.filter(d => d.comparison === \"K-Ont only vs OnT only\" && d.metric === \"AUC\");\n      const m = r.reduce((s, d) => s + Number(d.diff_pts), 0) / r.length;\n      return [{ value: (m > 0 ? \"+\" : \"\") + m.toFixed(1) + \" pts\", sig: r.filter(d => Number(d.p) < 0.05 && Number(d.diff_pts) > 0).length }]; } });\n  dash.calc(\"hl_full\", { inputs: [\"main_paired\"], title: \"Raw + K-Ont vs raw\",\n    description: \"Mean AUC change from adding K-Ont to the full table, across the 5 models.\",\n    fn: (main_paired) => { const r = main_paired.filter(d => d.comparison === \"Raw + K-Ont vs Raw table\" && d.metric === \"AUC\");\n      const m = r.reduce((s, d) => s + Number(d.diff_pts), 0) / r.length; return [{ value: (m > 0 ? \"+\" : \"\") + m.toFixed(1) + \" pts\" }]; } });\n  dash.calc(\"hl_few\", { inputs: [\"fewlabels_paired\"], title: \"Raw + K-Ont vs raw, 10% labels\",\n    description: \"Mean AUC change from adding K-Ont when classifiers see 10% of the labels, across the 5 models.\",\n    fn: (fewlabels_paired) => { const r = fewlabels_paired.filter(d => d.comparison === \"Raw + K-Ont vs Raw table\" && Number(d.labels_pct) === 10);\n      const m = r.reduce((s, d) => s + Number(d.auc_diff_pts), 0) / r.length; return [{ value: (m > 0 ? \"+\" : \"\") + m.toFixed(1) + \" pts\" }]; } });\n  dash.calc(\"hl_missing\", { inputs: [\"missing_paired\"], title: \"Raw + K-Ont vs raw, columns hidden\",\n    description: \"Mean AUC change from adding K-Ont when chest pain, thallium and vessels are hidden from the table, across the 5 models.\",\n    fn: (missing_paired) => { const r = missing_paired.filter(d => d.comparison === \"Raw + K-Ont vs Raw table\" && d.scenario === \"hide cp+thal+ca\");\n      const m = r.reduce((s, d) => s + Number(d.auc_diff_pts), 0) / r.length; return [{ value: (m > 0 ? \"+\" : \"\") + m.toFixed(1) + \" pts\" }]; } });\n  dash.calc(\"few_avg\", { inputs: [\"fewlabels\"], title: \"AUC by labels, all models\",\n    description: \"Mean AUC over the 5 models for each share of labels and feature set.\",\n    fn: (fewlabels) => { const g = {}; fewlabels.forEach(d => { const k = d.labels_pct + \"|\" + d.features; (g[k] = g[k] || []).push(Number(d.auc_pct)); });\n      return Object.entries(g).map(([k, v]) => { const [p, f] = k.split(\"|\"); return { labels_pct: Number(p), features: f, auc_pct: Math.round(v.reduce((s, x) => s + x, 0) / v.length * 10) / 10 }; }); } });\n\n  // ---------- helpers\n  function tipper(box) { let t = box.querySelector(\".tip\"); if (!t) { t = document.createElement(\"div\"); t.className = \"tip\"; t.hidden = true; box.appendChild(t); } return t; }\n  function showTip(box, tip, ev, lines) {\n    tip.replaceChildren(); lines.forEach((l, i) => { const d = document.createElement(\"div\"); if (i === 0) d.className = \"t\"; d.textContent = l; tip.appendChild(d); });\n    tip.hidden = false; const r = box.getBoundingClientRect(); let x = ev.clientX - r.left + 12, y = ev.clientY - r.top + 12;\n    x = Math.min(x, r.width - tip.offsetWidth - 4); tip.style.left = Math.max(0, x) + \"px\"; tip.style.top = y + \"px\"; }\n  function legend(el, items, ring) { el.replaceChildren(); items.forEach(([name, c]) => { const s = document.createElement(\"span\"); const w = document.createElement(\"i\"); w.className = \"sw\"; w.style.background = c; s.append(w, document.createTextNode(name)); el.appendChild(s); });\n    if (ring) { const s = document.createElement(\"span\"); const w = document.createElement(\"i\"); w.className = \"sw ring\"; w.style.color = \"var(--color-fg-muted)\"; s.append(w, document.createTextNode(ring)); el.appendChild(s); } }\n  function failed(el, st) { el.replaceChildren(); if (st === \"error\" || st === \"connect\") { const d = document.createElement(\"div\"); d.style.cssText = \"display:flex;align-items:center;justify-content:center;gap:.4rem;min-height:inherit;color:var(--color-fg-muted);font-size:var(--cds-font-size-caption)\"; const dot = document.createElement(\"i\"); dot.style.cssText = \"width:.375rem;height:.375rem;border-radius:50%;background:var(--color-bad)\"; d.append(dot, document.createTextNode(\"Failed to load\")); el.appendChild(d); } }\n  function textWidth(svg, txt) { const t = svg.append(\"text\").attr(\"font-size\", \"var(--cds-font-size-caption)\").text(txt); const w = t.node().getComputedTextLength(); t.remove(); return w; }\n  function axisStyle(g) { g.attr(\"font-size\", null).attr(\"font-family\", null); g.selectAll(\"text\").attr(\"fill\", \"var(--color-fg-muted)\").style(\"font-size\", \"var(--cds-font-size-caption)\"); g.selectAll(\"line,path\").attr(\"stroke\", \"var(--cds-chart-axis)\"); }\n\n  // dot plot: rows = categories (models), one dot per series\n  function dotplot(el, rows, cats, series, valueKey, xLabel) {\n    el.replaceChildren(); const W = el.clientWidth || 320; const svg = d3.select(el).append(\"svg\").attr(\"width\", \"100%\");\n    const left = Math.max(...cats.map(c => textWidth(svg, c))) + 12, right = 16, rowH = 30, top = 8, bottom = 34;\n    const H = top + bottom + rowH * cats.length; svg.attr(\"viewBox\", `0 0 ${W} ${H}`).attr(\"height\", H);\n    const vals = rows.map(r => Number(r[valueKey])); const lo = Math.floor(Math.min(...vals) - 1), hi = Math.ceil(Math.max(...vals) + 1);\n    const x = d3.scaleLinear([lo, hi], [left, W - right]); const y = d3.scaleBand(cats, [top, top + rowH * cats.length]).padding(0.3);\n    svg.append(\"g\").selectAll(\"line\").data(x.ti